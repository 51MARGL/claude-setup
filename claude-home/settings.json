{
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf /*)",
      "Bash(sudo *)",
      "Bash(shutdown *)",
      "Bash(diskpart *)",
      "Bash(format *)",
      "Bash(reg delete *)",
      "Bash(takeown *)",
      "Bash(icacls *)",
      "Bash(DROP TABLE *)",
      "Bash(DROP DATABASE *)",
      "Bash(TRUNCATE TABLE *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(Remove-Item C:\\Windows*)",
      "PowerShell(Remove-Item HKLM:*)",
      "PowerShell(Remove-Item HKCU:*)",
      "PowerShell(Remove-ItemProperty HKLM:*)",
      "PowerShell(Remove-PSDrive *)",
      "PowerShell(Format-Volume *)",
      "PowerShell(Clear-Disk *)",
      "PowerShell(Initialize-Disk *)",
      "PowerShell(diskpart *)",
      "PowerShell(format *)",
      "PowerShell(Stop-Computer *)",
      "PowerShell(Restart-Computer *)",
      "PowerShell(shutdown *)",
      "PowerShell(Set-ExecutionPolicy *)",
      "PowerShell(reg delete *)",
      "PowerShell(takeown *)",
      "PowerShell(icacls *)",
      "PowerShell(DROP TABLE *)",
      "PowerShell(DROP DATABASE *)",
      "PowerShell(TRUNCATE TABLE *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git checkout -- *)",
      "Bash(git branch -D *)",
      "Bash(git filter-branch *)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker system prune *)",
      "Bash(docker volume rm *)",
      "Bash(docker compose down *)",
      "Bash(kill *)",
      "Bash(npm publish *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "PowerShell(ri *)",
      "PowerShell(del *)",
      "PowerShell(erase *)",
      "PowerShell(rd *)",
      "PowerShell(rmdir *)",
      "PowerShell(Remove-ItemProperty *)",
      "PowerShell(Clear-Content *)",
      "PowerShell(Stop-Process *)",
      "PowerShell(Stop-Service *)",
      "PowerShell(Restart-Service *)",
      "PowerShell(Uninstall-Module *)",
      "PowerShell(Uninstall-Package *)",
      "PowerShell(Start-Process -Verb RunAs *)",
      "PowerShell(runas *)",
      "PowerShell(git clean *)",
      "PowerShell(git rebase *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git filter-branch *)",
      "PowerShell(docker rm *)",
      "PowerShell(docker rmi *)",
      "PowerShell(docker system prune *)",
      "PowerShell(docker volume rm *)",
      "PowerShell(docker compose down *)",
      "PowerShell(npm publish *)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent|Task|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-File",
              "{{CLAUDE_HOME}}/skills/strategic-compact/suggest-compact.ps1"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-File",
              "{{CLAUDE_HOME}}/hooks/notify.ps1"
            ],
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-File",
              "{{CLAUDE_HOME}}/hooks/notify.ps1"
            ],
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-File",
              "{{CLAUDE_HOME}}/hooks/notify.ps1"
            ],
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-File",
              "{{TEAM_SETUP_REPO}}/update.ps1"
            ],
            "timeout": 400,
            "statusMessage": "Checking for team Claude setup update..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -File \"{{CLAUDE_HOME}}/statusline.ps1\""
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true
}
