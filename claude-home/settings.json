  "model": "opus[1m]",
  "env": {
    "CODEGRAPH_TELEMETRY": "0"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-File",
              "{{CLAUDE_HOME}}/skills/strategic-compact/suggest-compact.ps1"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__codegraph__codegraph_explore",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-File",
              "{{CLAUDE_HOME}}/hooks/codegraph-search-guard.ps1",
              "post"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-File",
              "{{CLAUDE_HOME}}/skills/strategic-compact/suggest-compact.ps1"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-File",
              "{{CLAUDE_HOME}}/hooks/notify.ps1"
            ],
            "timeout": 30,
            "async": true
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-File",
              "{{CLAUDE_HOME}}/hooks/codegraph-search-guard.ps1",
              "pre"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-File",
              "{{CLAUDE_HOME}}/hooks/notify.ps1"
            ],
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-File",
              "{{CLAUDE_HOME}}/hooks/notify.ps1"
            ],
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-File",
              "{{TEAM_SETUP_REPO}}/update.ps1"
            ],
            "timeout": 400,
            "statusMessage": "Checking for team Claude setup update and CodeGraph..."
          },
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-File",
              "{{CLAUDE_HOME}}/hooks/codegraph-init.ps1"
            ],
            "timeout": 660,
            "async": false,
            "statusMessage": "Initializing CodeGraph..."
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-File",
              "{{CLAUDE_HOME}}/hooks/main-session-rules.ps1"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -File \"{{CLAUDE_HOME}}/statusline.ps1\""
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "disableClaudeAiConnectors": true
}
